# Образец переменных окружения. Скопируйте в .env: cp .env.example .env

# Подключение к PostgreSQL: postgresql://пользователь:пароль@адрес:порт/база
# Значения совпадают с docker-compose.yml.
DATABASE_URL=postgresql://avocado:avocado@localhost:5432/avocado

# Адрес сайта: для ссылок и авторизации. Локально — http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ключ подписи сессий (не меньше 32 символов). На боевом сайте — свой: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-change-me-0123456789

# Администратор сайта. Создаётся командой pnpm db:seed.
ADMIN_EMAIL=admin@avocado.local
ADMIN_PASSWORD=avocado-admin
